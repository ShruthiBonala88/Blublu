# ===================================================
# BLUBLU BACKEND - 100% FREE & ZERO-COST CONFIGURATION
# ===================================================

# Server Port (Free Local HTTP Server)
PORT=8080

# Database (Free Self-Hosted PostgreSQL + PostGIS via Docker)
DATABASE_URL=postgres://blublu:blublu_dev_password@localhost:5433/blublu?sslmode=disable

# Payments (100% Free Razorpay Test / Sandbox Mode - No Money Charged)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Maps & Routing (100% Free OpenStreetMap OSRM - No API Key Needed)
MAP_PROVIDER=osrm
MAPS_API_KEY=

# SMS & OTP (100% Free Simulated Console SMS Provider - No Paid SMS Service Needed)
APP_ENV=development
# Security
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_REQUEST_BODY_BYTES=1048576

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60

# OTP Rate Limiting
OTP_RATE_LIMIT=5
OTP_RATE_LIMIT_WINDOW_SECONDS=300

# Login Rate Limiting
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Redis
REDIS_URL=redis://127.0.0.1:6379