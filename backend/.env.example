# ===================================================
# BLUBLU BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Server Configuration
PORT=8080
APP_ENV=development # development | staging | production
PAYMENT_ENV=test    # test | live

# Security Credentials (MUST be set securely in Production)
JWT_SECRET=replace-with-a-long-high-entropy-random-secret-key-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://blublu:blublu_dev_password@localhost:5433/blublu?sslmode=disable

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Payments (Razorpay Sandbox / Test Mode Defaults)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Production SMS Gateway Configuration (Placeholders for AWS SNS / Twilio / MSG91)
SMS_PROVIDER=console # console | twilio | aws_sns | msg91
SMS_API_KEY=placeholder_sms_api_key
SMS_SENDER_ID=BLUBLU

# Routing & Maps (100% Free OpenStreetMap OSRM Default)
MAP_PROVIDER=osrm # osrm | google
MAPS_API_KEY=

# System Limits & Security Thresholds
MAX_REQUEST_BODY_BYTES=1048576 # 1 MB
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60

# OTP & Authentication Rate Limits
OTP_RATE_LIMIT=5
OTP_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300